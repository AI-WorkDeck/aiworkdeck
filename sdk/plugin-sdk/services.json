{
  "$comment": "Host service table (spec v2.13, section 20). Keys are the service/operation names used by awd.services.request and by declarative tools (handler.type=service). Published copy of the backend HostServiceRegistry; plugin-dev validate checks declarations against it offline. Additive only.",
  "version": 1,
  "services": {
    "calendar": {
      "operations": {
        "list": { "access": "read", "requiredPermissions": ["tasks"] },
        "listForUser": { "access": "read", "requiredPermissions": ["tasks"] },
        "create": { "access": "write", "requiredPermissions": ["tasks"] },
        "update": { "access": "write", "requiredPermissions": ["tasks"] },
        "delete": { "access": "destructive", "requiredPermissions": ["tasks"] }
      }
    },
    "search": {
      "operations": {
        "query": { "access": "read", "requiredPermissions": ["file_read"] },
        "tags": { "access": "read", "requiredPermissions": ["file_read"] }
      }
    },
    "sensitive": {
      "operations": {
        "preview": { "access": "read", "requiredPermissions": ["file_read", "file_write"] },
        "redact": { "access": "write", "requiredPermissions": ["file_read", "file_write"] }
      }
    },
    "lawfirm": {
      "operations": {
        "overview": { "access": "read", "requiredPermissions": ["lawfirm"] },
        "conflictCheck": { "access": "read", "requiredPermissions": ["lawfirm"] },
        "feeLedger": { "access": "read", "requiredPermissions": ["lawfirm"] }
      }
    },
    "im": {
      "operations": {
        "listConversations": { "access": "read", "requiredPermissions": ["im"] },
        "readMessages": { "access": "read", "requiredPermissions": ["im"] }
      }
    },
    "worklog": {
      "operations": {
        "summary": { "access": "read", "requiredPermissions": ["worklog_read"] }
      }
    }
  }
}
