          ]
        ],
        "mustNotUse": [
          "write_docx",
          "move_to_trash"
        ],
        "maxRounds": 10,
        "_note": "g02 的「之后」版（gap 2026-11-11 P3）：新条款在最终 docx 里独立成段、位于第三条与第四条之间、带 <w:ins>；maxRounds 10 = P3 的「无一轮超过 10」",
        "outcomeCheck": "const HOST = '合同.docx'; const f = (await ctx.files()).find(x => !x.is_deleted && !x.is_folder && x.name === HOST); if (!f) return false; const xml = ctx.docxXml(await ctx.bytes(f.id)); const ps = (xml.match(/<w:p[ >][\\s\\S]*?<\\/w:p>/g) || []).map(p => ({ xml: p, text: (p.replace(/<w:del\\b[^>]*[^\\/]>[\\s\\S]*?<\\/w:del>/g, '').match(/<w:t(?: [^>]*)?>[^<]*<\\/w:t>/g) || []).map(t => t.replace(/<[^>]+>/g, '')).join('') })); const at = re => ps.findIndex(p => re.test(p.text)); const prev = at(/收到货物后/), next = at(/按合同总价的/); const hit = ps.map((p, i) => /合格证|certificate/i.test(p.text) ? i : -1).filter(i => i >= 0); return prev >= 0 && next > prev && hit.length > 0 && hit.every(i => i > prev && i < next && !/收到货物后/.test(ps[i].text) && !/按合同总价的/.test(ps[i].text) && /<w:ins\\b/.test(ps[i].xml));"
      }
