        ],
        "mustUse": [
          [
            "doc_insert_under_heading",
            "doc_insert_at_cursor",
            "doc_replace_at_anchor",
            "doc_modify_paragraph",
            "doc_insert_note",
            "doc_insert_break"
          ]
        ],
        "mustNotUse": [
          "write_docx",
          "move_to_trash"
        ],
        "maxRounds": 14,
        "_note": "outcomeCheck（gap 2026-11-11 P3）：保密条款在最终 docx 里独立成段（不与第四/第五条同段）、位于第四条与第五条之间、带插入修订 <w:ins>；修订颗粒度之外的写法（标题+正文两段、顺延条号）都算对",
        "outcomeCheck": "const HOST = '合同.docx'; const f = (await ctx.files()).find(x => !x.is_deleted && !x.is_folder && x.name === HOST); if (!f) return false; const xml = ctx.docxXml(await ctx.bytes(f.id)); const ps = (xml.match(/<w:p[ >][\\s\\S]*?<\\/w:p>/g) || []).map(p => ({ xml: p, text: (p.replace(/<w:del\\b[^>]*[^\\/]>[\\s\\S]*?<\\/w:del>/g, '').match(/<w:t(?: [^>]*)?>[^<]*<\\/w:t>/g) || []).map(t => t.replace(/<[^>]+>/g, '')).join('') })); const at = re => ps.findIndex(p => re.test(p.text)); const prev = at(/按合同总价的/), next = at(/示范仲裁委员会/); const hit = ps.map((p, i) => /保密|confidential/i.test(p.text) ? i : -1).filter(i => i >= 0); return prev >= 0 && next > prev && hit.length > 0 && hit.every(i => i > prev && i < next && !/按合同总价的/.test(ps[i].text) && !/示范仲裁委员会/.test(ps[i].text) && /<w:ins\\b/.test(ps[i].xml));"
      }
    },
    {
      "id": "g19-insert-clause-after",
      "text": "在第三条后面新增一条：乙方交货时应随附产品合格证和出厂检验报告",
      "hostState": "docx:contract",
      "expect": {
        "firstToolAnyOf": [
          "doc_get_document_text",
          "doc_get_clauses",
          "doc_find_text",
          "doc_get_outline",
