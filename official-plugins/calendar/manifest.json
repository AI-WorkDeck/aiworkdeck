{
  "id": "calendar",
  "name": "日程",
  "version": "1.1.3",
  "minHostVersion": "0.73.0",
  "description": "跨项目日历、任务、提醒和文件关联。",
  "author": "AI WorkDeck",
  "permissions": [
    "tasks",
    "file_read"
  ],
  "frontendEntry": "web/index.html",
  "tools": [
    {
      "name": "calendar_agenda",
      "description": "%tool.calendar_agenda.description%",
      "access": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "Start date (inclusive), ISO yyyy-MM-dd. Omit for no lower bound."
          },
          "to": {
            "type": "string",
            "description": "End date (inclusive), ISO yyyy-MM-dd. Omit for no upper bound."
          }
        },
        "additionalProperties": false
      },
      "handler": {
        "type": "service",
        "service": "calendar",
        "operation": "listForUser"
      },
      "permissions": [
        "tasks"
      ],
      "keywords": [
        "日程",
        "截止",
        "开庭",
        "本周",
        "下周",
        "待办",
        "提醒",
        "deadline",
        "agenda",
        "calendar",
        "schedule"
      ]
    },
    {
      "name": "calendar_create",
      "description": "%tool.calendar_create.description%",
      "access": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "integer",
            "description": "Target project id. Defaults to the current project of the conversation."
          },
          "title": {
            "type": "string",
            "description": "Short title of the item."
          },
          "dueDate": {
            "type": "string",
            "description": "Date, ISO yyyy-MM-dd."
          },
          "dueTime": {
            "type": "string",
            "description": "Time HH:mm (24h). Omit for an all-day item."
          },
          "type": {
            "type": "string",
            "description": "DEADLINE (default), HEARING, MEETING, TODO or OTHER."
          },
          "notes": {
            "type": "string",
            "description": "Optional plain-text notes."
          }
        },
        "required": [
          "title",
          "dueDate"
        ],
        "additionalProperties": false
      },
      "handler": {
        "type": "service",
        "service": "calendar",
        "operation": "create"
      },
      "permissions": [
        "tasks"
      ],
      "keywords": [
        "日程",
        "提醒",
        "开庭",
        "截止",
        "待办",
        "加个",
        "deadline",
        "reminder",
        "calendar",
        "schedule"
      ]
    }
  ],
  "contributes": {
    "views": [
      {
        "id": "sidebar",
        "name": "日程",
        "entry": "web/index.html",
        "placement": "sidebar",
        "scope": "global",
        "defaultDock": "left",
        "allowedDocks": [
          "left"
        ]
      },
      {
        "id": "main",
        "name": "日程",
        "entry": "web/index.html",
        "placement": "workspace",
        "scope": "global"
      }
    ]
  }
}
