{
  "id": "calendar",
  "name": "日程",
  "version": "1.1.0",
  "description": "跨项目日历、任务、提醒和文件关联。",
  "author": "AI WorkDeck",
  "permissions": [
    "tasks",
    "file_read"
  ],
  "frontendEntry": "web/index.html",
  "contributes": {
    "views": [
      {
        "id": "sidebar",
        "name": "日程",
        "entry": "web/index.html",
        "placement": "sidebar",
        "scope": "global",
        "defaultDock": "left",
        "allowedDocks": [
          "left"
        ]
      },
      {
        "id": "main",
        "name": "日程",
        "entry": "web/index.html",
        "placement": "workspace",
        "scope": "global"
      }
    ]
  }
}
