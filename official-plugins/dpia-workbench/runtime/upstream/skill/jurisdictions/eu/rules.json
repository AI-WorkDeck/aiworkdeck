      "exceptions": "另核35(5)/(10)和适用例外；冲突不可静默覆盖。",
      "output_field": "rule_assessments",
      "version": "0.1.0"
    },
    {
      "id": "EU-T04",
      "jurisdiction": "EU",
      "kind": "trigger",
      "title": "一般可能高风险",
      "legal_force": "statute",
      "source_refs": [
        {
          "source_id": "EU-GDPR",
          "locator": "35(1)"
        }
      ],
      "required_facts": [
        "nature",
