    {
      "id": "EU-T01",
      "jurisdiction": "EU",
      "kind": "trigger",
      "title": "系统且广泛评价并据此作出重大决定",
      "legal_force": "statute",
      "source_refs": [
        {
          "source_id": "EU-GDPR",
          "locator": "35(3)(a)"
        }
      ],
      "required_facts": [
        "systematic_extensive_evaluation",
        "automated_processing",
        "legal_or_similar_effect"
      ],
      "logic": "完整组合条件满足才met。",
      "exceptions": "另核35(5)/(10)和适用例外；冲突不可静默覆盖。",
      "output_field": "rule_assessments",
      "version": "0.1.0"
    },
    {
      "id": "EU-T02",
      "jurisdiction": "EU",
      "kind": "trigger",
      "title": "大规模特殊类别或犯罪数据",
      "legal_force": "statute",
      "source_refs": [
        {
          "source_id": "EU-GDPR",
          "locator": "35(3)(b)"
        }
      ],
      "required_facts": [
        "data_categories",
        "scale"
      ],
      "logic": "特殊类别或Art10数据与大规模同时满足。",
      "exceptions": "另核35(5)/(10)和适用例外；冲突不可静默覆盖。",
      "output_field": "rule_assessments",
      "version": "0.1.0"
    },
    {
      "id": "EU-T03",
      "jurisdiction": "EU",
      "kind": "trigger",
      "title": "大规模系统监测公共可进入区域",
      "legal_force": "statute",
