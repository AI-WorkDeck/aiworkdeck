      ]
    },
    {
      "name": "lawfirm_management_fee_ledger",
      "description": "%tool.lawfirm_management_fee_ledger.desc%",
      "access": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "invoices",
              "collections",
              "both"
            ],
            "description": "Which ledger to return (default both)"
          },
          "projectId": {
            "type": "integer",
            "description": "Optional: only rows linked to this project (requires project read access)"
          },
          "query": {
            "type": "string",
            "description": "Optional keyword matched against ledger rows (matter, payer, number)"
          },
          "limit": {
            "type": "integer",
            "description": "Max rows per list, 1-100 (default 50)"
          }
        },
        "additionalProperties": false
      },
      "handler": {
        "type": "service",
        "service": "lawfirm",
        "operation": "feeLedger"
      },
      "permissions": [
        "lawfirm"
      ],
      "keywords": [
        "收费",
