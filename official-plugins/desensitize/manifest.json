{
  "id": "desensitize",
  "name": "文件脱敏",
  "version": "1.0.8",
  "minHostVersion": "0.78.0",
  "description": "核查敏感信息并生成脱敏副本，可用恢复包复敏。",
  "author": "AI WorkDeck",
  "permissions": [
    "file_read",
    "file_write",
    "editor"
  ],
  "tools": [
    {
      "name": "desensitize_preview",
      "description": "%tool.desensitize_preview.desc%",
      "access": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "integer",
            "description": "Project file id"
          },
          "strategies": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Detection strategy id"
            },
            "description": "Optional detection strategy codes (COMPANY, CHINESE_NAME, PHONE, ID_CARD, UNIFIED_SOCIAL_CREDIT, LAWYER_LICENSE, EMAIL, BANK_CARD, ADDRESS, ...). Omit to use the panel defaults"
          },
          "customTerms": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Term"
            },
            "description": "Extra terms to treat as sensitive"
          },
          "excludedTerms": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Term"
            },
            "description": "Terms to leave untouched"
          }
        },
        "additionalProperties": false,
        "required": [
          "fileId"
        ]
      },
      "handler": {
        "type": "service",
        "service": "sensitive",
        "operation": "preview"
      },
      "permissions": [
        "file_read",
        "file_write"
      ],
      "keywords": [
        "脱敏",
        "匿名化",
        "隐去",
        "打码",
        "遮盖",
        "敏感信息",
        "desensitize",
        "redact",
        "anonymize",
        "sensitive info",
        "redaction",
        "redacted",
        "redacting",
        "anonymise",
        "anonymization",
        "anonymisation",
        "anonymized",
        "mask",
        "masks",
        "masked",
        "masking",
        "black out",
        "blackout",
        "obscure",
        "scrub",
        "de-identify",
        "deidentify",
        "pseudonymize",
        "pii",
        "personal data",
        "personal information",
        "sensitive data",
        "sensitive information"
      ]
    },
    {
      "name": "desensitize_redact",
      "description": "%tool.desensitize_redact.desc%",
      "access": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "integer",
            "description": "Project file id"
          },
          "strategies": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Detection strategy id"
            },
            "description": "Optional detection strategy codes (COMPANY, CHINESE_NAME, PHONE, ID_CARD, UNIFIED_SOCIAL_CREDIT, LAWYER_LICENSE, EMAIL, BANK_CARD, ADDRESS, ...). Omit to use the panel defaults"
          },
          "customTerms": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Term"
            },
            "description": "Extra terms to treat as sensitive"
          },
          "excludedTerms": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Term"
            },
            "description": "Terms to leave untouched"
          }
        },
        "additionalProperties": false,
        "required": [
          "fileId"
        ]
      },
      "handler": {
        "type": "service",
        "service": "sensitive",
        "operation": "redact"
      },
      "permissions": [
        "file_read",
        "file_write"
      ],
      "keywords": [
        "脱敏",
        "匿名化",
        "隐去",
        "打码",
        "遮盖",
        "敏感信息",
        "desensitize",
        "redact",
        "anonymize",
        "sensitive info",
        "redaction",
        "redacted",
        "redacting",
        "anonymise",
        "anonymization",
        "anonymisation",
        "anonymized",
        "mask",
        "masks",
        "masked",
        "masking",
        "black out",
        "blackout",
        "obscure",
        "scrub",
        "de-identify",
        "deidentify",
        "pseudonymize",
        "pii",
        "personal data",
        "personal information",
        "sensitive data",
        "sensitive information"
      ]
    }
  ],
  "frontendEntry": "web/index.html",
  "contributes": {
    "views": [
      {
        "id": "main",
        "name": "文件脱敏",
        "entry": "web/index.html",
        "placement": "sidebar",
        "scope": "project",
        "defaultDock": "left",
        "allowedDocks": [
          "left"
        ]
      }
    ]
  }
}
