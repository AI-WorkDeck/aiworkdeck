{
  "id": "project-im",
  "name": "项目沟通",
  "version": "0.2.4",
  "description": "律所、团队与项目的沟通：共享助手、私聊、文件归档与 AI 引用。目前仅支持中国大陆站账号，国际站暂未开通。",
  "author": "AI WorkDeck",
  "minHostVersion": "0.69.0",
  "permissions": ["im", "ai", "file_read", "file_write"],
  "frontendEntry": "web/index.html",
  "backendJars": [],
  "tools": [
    {
      "name": "project_im_list_conversations",
      "description": "%tool.project_im_list_conversations.desc%",
      "access": "read",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "handler": {
        "type": "service",
        "service": "im",
        "operation": "listConversations"
      },
      "permissions": [
        "im"
      ],
      "keywords": [
        "沟通会话",
        "私聊",
        "群聊",
        "站内信",
        "conversations",
        "direct message",
        "chat list"
      ]
    },
    {
      "name": "project_im_read_messages",
      "description": "%tool.project_im_read_messages.desc%",
      "access": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "imConversationId": {
            "type": "string",
            "description": "Conversation id from project_im_list_conversations"
          },
          "limit": {
            "type": "integer",
            "description": "Max messages, 1-100 (default 30)"
          },
          "beforeId": {
            "type": "integer",
            "description": "Page backwards: messages with id lower than this"
          },
          "afterId": {
            "type": "integer",
            "description": "Page forwards: messages with id higher than this"
          }
        },
        "additionalProperties": false,
        "required": [
          "imConversationId"
        ]
      },
      "handler": {
        "type": "service",
        "service": "im",
        "operation": "readMessages"
      },
      "permissions": [
        "im"
      ],
      "keywords": [
        "聊天记录",
        "沟通消息",
        "读取消息",
        "chat messages",
        "read messages",
        "message history"
      ]
    }
  ],
  "skills": []
}
