{
  "id": "aifirm-partner",
  "name": "AI Firm 律师端",
  "version": "1.1.0",
  "minHostVersion": "0.91.0",
  "description": "美国执业律师接入 AI Firm 案源广场与专属工作台：订阅月卡或季卡后即可查看去标识化客户需求与风险提示，最多 3 位订阅律师报价响应，客户选定 1 位后解锁完整联系方式与草稿文件并在 AI WorkDeck 中修改审定定稿（平台 0% 抽成）。覆盖美国硅谷。",
  "author": "AI WorkDeck",
  "permissions": [
    "network",
    "ai",
    "file_read",
    "file_write",
    "tasks",
    "notifications",
    "speech",
    "lawfirm"
  ],
  "frontendEntry": "web/index.html",
  "tools": [
    {
      "name": "aifirmPartnerPutDocx",
      "description": "把案件文件的 Word 版本放进当前项目，供在 AI WorkDeck 编辑器中修改（同名文件已存在时不覆盖）",
      "permissions": [
        "file_write"
      ],
      "agent": false
    },
    {
      "name": "aifirmPartnerReadDocx",
      "description": "读取当前项目中律师修改过的 Word 文件，供保存为案件的新版本",
      "permissions": [
        "file_read"
      ],
      "agent": false
    }
  ],
  "backendJars": [
    "aifirm-partner-1.1.0.jar"
  ],
  "contributes": {
    "views": [
      {
        "id": "main",
        "name": "AI Firm 律师端",
        "entry": "web/index.html",
        "placement": "workspace",
        "scope": "global"
      },
      {
        "id": "card",
        "name": "AI Firm 律师端",
        "entry": "web/card.html",
        "placement": "sidebar",
        "scope": "global",
        "allowedDocks": [
          "left"
        ],
        "defaultDock": "left"
      }
    ],
    "connections": [
      {
        "id": "intake",
        "label": "AI Firm 律师端 · AI Firm Lawyer Desk",
        "baseUrl": "https://ai-firm.aiworkdeck.com",
        "auth": {
          "type": "awd-account"
        },
        "operations": {
          "portalMe": {
            "path": "/api/portal/me",
            "method": "GET"
          },
          "marketplacePreview": {
            "path": "/api/portal/marketplace/preview",
            "method": "GET",
            "anonymousFallback": true
          },
          "marketplaceLeads": {
            "path": "/api/portal/marketplace/leads",
            "method": "GET"
          },
          "marketplaceLead": {
            "path": "/api/portal/marketplace/lead",
            "method": "GET"
          },
          "marketplaceBid": {
            "path": "/api/portal/marketplace/bid",
            "method": "POST"
          },
          "marketplaceWithdraw": {
            "path": "/api/portal/marketplace/withdraw",
            "method": "POST"
          },
          "lawyerProfile": {
            "path": "/api/portal/lawyer/profile",
            "method": "GET"
          },
          "lawyerProfileSave": {
            "path": "/api/portal/lawyer/profile",
            "method": "POST"
          },
          "summary": {
            "path": "/api/portal/summary",
            "method": "GET"
          },
          "leads": {
            "path": "/api/portal/leads",
            "method": "GET"
          },
          "lead": {
            "path": "/api/portal/lead",
            "method": "GET"
          },
          "update": {
            "path": "/api/portal/lead/update",
            "method": "POST"
          },
          "brief": {
            "path": "/api/portal/lead/brief",
            "method": "POST"
          },
          "export": {
            "path": "/api/portal/export",
            "method": "GET"
          },
          "qr": {
            "path": "/api/portal/qr",
            "method": "GET"
          },
          "matters": {
            "path": "/api/portal/matters",
            "method": "GET"
          },
          "matter": {
            "path": "/api/portal/matter",
            "method": "GET"
          },
          "matterUpdate": {
            "path": "/api/portal/matter/update",
            "method": "POST"
          },
          "matterMessage": {
            "path": "/api/portal/matter/message",
            "method": "POST"
          },
          "matterVersion": {
            "path": "/api/portal/matter/version",
            "method": "POST"
          },
          "matterSignoff": {
            "path": "/api/portal/matter/signoff",
            "method": "POST"
          },
          "matterConsult": {
            "path": "/api/portal/matter/consult",
            "method": "POST"
          },
          "matterDocx": {
            "path": "/api/portal/matter/docx",
            "method": "GET"
          },
          "matterVersionDocx": {
            "path": "/api/portal/matter/version-docx",
            "method": "POST"
          },
          "svConfig": {
            "path": "/sv/api/matter/config",
            "method": "GET"
          }
        }
      }
    ]
  },
  "icon": "assets/icon-512.png",
  "homepage": "https://www.aiworkdeck.com/zh/marketplace/plugins"
}
