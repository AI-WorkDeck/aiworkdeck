# 优化者进程的环境变量。复制到 ~/aiworkdeck-optimizer-run/optimizer.env 并 chmod 600。
# 里面有 token 与邮箱授权码，**不要进仓库**。

# ---- 反馈从哪来：云端收件箱 ----
OPTIMIZER_SOURCE=remote
OPTIMIZER_REMOTE_URL=https://addin.aiworkdeck.com
# 通知里「在浏览器里看这条反馈」的地址模板（{id} 占位）；留空用云端反馈控制台。
# 官网 admin 有「用户反馈」分区（dev-board#152）后指到官网，统一登录：
OPTIMIZER_REMOTE_CONSOLE_URL=https://www.aiworkdeck.com/zh/admin?tab=feedback&fb={id}
# 与收件箱那侧的 FEEDBACK_OPTIMIZER_TOKEN 必须一字不差
OPTIMIZER_REMOTE_TOKEN=

# ---- 优化者本体 ----
OPTIMIZER_ENABLED=true
# 每天 09:00 一轮；每周一次写 "0 0 9 * * MON"。
# **引号不能省**：这个文件是被 bash source 的，不加引号会被拆成
# `OPTIMIZER_CRON=0` 加一条名为 `0` 的命令，启动直接失败。
OPTIMIZER_CRON="0 0 9 * * *"
# 仓库工作副本（会在它上面开临时 worktree，不动你当前工作区）
OPTIMIZER_REPO_PATH=/Users/zewei/aiworkdeck-optimizer
OPTIMIZER_BASE_BRANCH=master

# ---- 通知出口（建议/拿不准走这条）----
# auto（默认）：配了发信通道就发邮件，没配就开 GitHub Issue（复用 gh 登录，零新增凭据）
# 也可显式指定 mail / issue / both
OPTIMIZER_NOTIFY_CHANNEL=auto

# 邮件是可选的。发信不走 spring.mail.*，走仓库自己的双通道（国内/国外按收件域名分流，
# 见 backend .../service/mail 与 application.yml 的 mail 段）——只配一条也能工作：
#   国内收件人（QQ/163/126/139…）→ 阿里云邮件推送
# MAIL_DOMESTIC_ENABLED=true
# MAIL_DOMESTIC_USERNAME=<发信地址本身>
# MAIL_DOMESTIC_PASSWORD=<控制台「发信地址→设置SMTP密码」设的那个，不是 AccessKey>
# MAIL_DOMESTIC_FROM=<同上发信地址>
#   其余收件人（Gmail/Outlook/自有域名…）→ Resend
# MAIL_GLOBAL_ENABLED=true
# MAIL_GLOBAL_PASSWORD=<re_ 开头的 API key；用户名固定字面量 resend>
# MAIL_GLOBAL_FROM=<send.aiworkdeck.com 下的发信地址>
# 收件人（你自己）：
OPTIMIZER_MAIL_TO=

# ---- 编码 Agent（默认 claude -p）----
# 换成别的把整条命令按下标覆盖（Spring 的列表环境变量绑定），例如 codex：
# OPTIMIZER_AGENT_COMMAND_0=codex
# OPTIMIZER_AGENT_COMMAND_1=exec
# OPTIMIZER_AGENT_COMMAND_2=-m
# OPTIMIZER_AGENT_COMMAND_3=gpt-5.5
# OPTIMIZER_AGENT_COMMAND_4=--sandbox
# OPTIMIZER_AGENT_COMMAND_5=workspace-write
# OPTIMIZER_AGENT_COMMAND_6={prompt}

# ---- 分诊模型 ----
# 优化者进程自己要能调模型（与桌面 app 的配置无关）
OPENROUTER_API_KEY=
# 留空则用后端默认模型
OPTIMIZER_MODEL=

# ---- 这台机器上的本地反馈不要外发 ----
# 优化者进程自己也是一个后端，别让它把自己的空库往云端传
FEEDBACK_UPLOAD_ENABLED=false
