# /opt/aiworkdeck/cloud/env —— systemd EnvironmentFile（权限必须 0600）
# 真实值只存在服务器上，本文件是占位模板。

# PostgreSQL 专用账号口令（库 aiworkdeck_cloud）
DB_PASSWORD=CHANGE_ME

# per-user 平台 AI key 的落库加密密钥：openssl rand -base64 32
# 启动强不变式：awdk-login-enabled=true 时缺失则 PlatformAiKeyCipher 直接拒绝启动。
# 与官网侧 AWD_KEY_ENCRYPTION_SECRET 是两把互不相干的密钥，绝不复用同一个值。
AWD_PLATFORM_KEY_SECRET=CHANGE_ME

# 会话/账户状态文件目录（license/account/entitlements 等落 ~/.aiworkdeck）
HOME=/opt/aiworkdeck/cloud/home

# 可选：登录短信验证（大陆阿里云通道）
# SMS_AUTH_ENABLED=true
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=

# 可选：境外短信（Twilio）
# SMS_INTL_ENABLED=true
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
