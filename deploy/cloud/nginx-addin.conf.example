# addin.aiworkdeck.com —— 官方托管的插件云后端 + Web 客户端（h5 + LOWA 编辑器）
# 部署在北京 ECS（8.152.169.44），与官网共机。只新增本 server 块，不改任何既有配置。
#
# 结构沿袭 deploy/web/nginx.conf.example（COOP/COEP 全站头 + brotli 回放 + /api/ SSE 反代），
# 差异只有域名、目录与证书路径。
#
# nginx 坑：location 里出现任意 add_header 会丢弃上层继承的 add_header，
# 所以每个带 add_header 的 location 都必须重复 COOP/COEP 两行。

server {
    listen 80;
    server_name addin.aiworkdeck.com;
    # certbot webroot 验证
    location /.well-known/acme-challenge/ {
        root /opt/aiworkdeck/cloud/acme;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name addin.aiworkdeck.com;
    ssl_certificate     /etc/letsencrypt/live/addin.aiworkdeck.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/addin.aiworkdeck.com/privkey.pem;

    root /opt/aiworkdeck/cloud/web;
    index index.html;

    # ---- 跨域隔离（LOWA 需要 SharedArrayBuffer）----
    add_header Cross-Origin-Opener-Policy   same-origin  always;
    add_header Cross-Origin-Embedder-Policy require-corp always;

    # ---- 后端 API（Spring Boot :9696，只监听 127.0.0.1）----
    location /api/ {
        proxy_pass http://127.0.0.1:9696;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE（AI 编排器事件流）：关缓冲、放长超时
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        # 大文件上传（文档解析）
        client_max_body_size 200m;
    }

    # ---- 登录/桥接端点限频（多实例部署的 AuthAbuseGuard 前置闸；单实例也留着）----
    location = /api/auth/awdk-login {
        limit_req zone=awd_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:9696;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /api/auth/login {
        limit_req zone=awd_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:9696;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- 反馈控制台（维护者用；优化者邮件里的「后台直达」落点）----
    # 页面在 backend.jar 的 classpath:/static/feedback-console/，随后端一起发版，
    # 这里只需反代给后端；无需在 web/ 下铺任何文件。
    location /feedback-console/ {
        proxy_pass http://127.0.0.1:9696;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- Office 插件任务窗格（dist-deploy 托管在 web/office-addin/）----
    # office.js 必须从微软 CDN 加载（跨域脚本），COEP require-corp 会拦掉它，
    # 因此本路径不得继承全站 COOP/COEP——location 内出现任意 add_header 即丢弃继承头，
    # 这里的 Cache-Control 同时兼任「豁免开关」，删掉它头就会漏回来。
    location /office-addin/ {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ =404;
    }

    # ---- LOWA 运行时：brotli 预压缩文件按原编码回放 ----
    # 若 lowa/.encodings.json 里对应文件不是 "br"，删掉对应 location。
    location = /zetaoffice/lowa/soffice.wasm {
        add_header Cross-Origin-Opener-Policy   same-origin  always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Content-Encoding br always;
        types { } default_type application/wasm;
    }
    location = /zetaoffice/lowa/soffice.data {
        add_header Cross-Origin-Opener-Policy   same-origin  always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Content-Encoding br always;
        types { } default_type application/octet-stream;
    }

    # ---- 入口文档永不缓存 ----
    # assets 是 hash 名可以长缓存，index.html 一旦被浏览器缓存住，用户就会一直跑在
    # 旧包上：2026-08-17 实测过一次——旧包的 bug 是「未登录整页无限刷新」，前端修好
    # 并铺开之后，本地缓存里的老 index.html 仍把人钉在旧包上继续刷。
    # 本 location 内出现 add_header 即丢弃继承的 COOP/COEP，必须原样补回，
    # 否则 LOWA 编辑器要的 SharedArrayBuffer 会失效。
    location = /index.html {
        add_header Cross-Origin-Opener-Policy   same-origin  always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cache-Control "no-cache" always;
    }

    # ---- SPA 回退 ----
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# 放到 http{} 级别的限频 zone（宝塔机上进 /www/server/nginx/conf/nginx.conf 的 http 块，
# 或单独 conf.d 文件）：
#   limit_req_zone $binary_remote_addr zone=awd_auth:10m rate=10r/m;
