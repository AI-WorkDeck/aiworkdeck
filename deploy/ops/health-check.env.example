# /etc/aiworkdeck/health-check.env（0600 root）——awd-health-check.py 的配置。
# 管理端口默认 = "1" + 实例端口：addin(cloud) 19696，case 19797。
AWD_HC_TARGETS="addin=http://127.0.0.1:19696 case=http://127.0.0.1:19797"
# label=path，空格分隔；每个存储根各一条（同盘也无妨，告警名会区分）
AWD_HC_DISK_PATHS="addin=/opt/aiworkdeck/cloud/data case=/data/aiworkdeck-case/store"

# 告警通道 = site-probe 同一套：阿里云通知模板 SMS_512065498 +（可选）Resend 邮件。
# 手机号与 site-probe.json 里的同一组，逗号分隔。
AWD_HC_PHONES=
# SMS_ACCESS_KEY_ID / SMS_ACCESS_KEY_SECRET：北京机从 /opt/aiworkdeck/cloud/env 读（unit 已引）；
# 新加坡机没有短信 AK 在实例 env 里，照 site-probe.env 的做法在这里填（awd-gateway-sms 子账号）。
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# RESEND_API_KEY=            # 留空则只发短信；恢复通知只走邮件
# AWD_HC_EMAIL_TO=
# AWD_HC_EMAIL_FROM="AI WorkDeck Ops <ops@aiworkdeck.com>"

# 阈值（以下为默认值）
# AWD_HC_5XX_RATIO=0.05      # 两次巡检之间 5xx 占比 ≥5% 且
# AWD_HC_5XX_MIN=5           #   5xx 条数 ≥5，连续 2 轮
# AWD_HC_HEAP_RATIO=0.90     # 堆占用 ≥90%，连续 3 轮
# AWD_HC_DISK_FREE_RATIO=0.10 # 可用 <10% 或
# AWD_HC_DISK_FREE_MIN_GB=5  #   可用 <5GB，连续 2 轮
# AWD_HC_REPEAT_HOURS=6      # 持续故障每 6 小时再提醒一次
# 数据库连接池有线程在排队（hikaricp pending ≥1）连续 3 轮；/actuator/health 非 UP 或不可达连续 2 轮。
