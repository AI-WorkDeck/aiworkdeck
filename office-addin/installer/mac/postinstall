#!/bin/bash
# AI WorkDeck Office 插件 pkg 的 postinstall：把生产 manifest 种进当前控制台用户的
# Word/Excel/PowerPoint sideload 目录（Office for Mac 的 wef 机制，微软官方 sideload 路径）。
# pkg 本身无 payload，本脚本是唯一动作；卸载 = 删掉三个 wef 目录里的 aiworkdeck-manifest.xml。
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Installer.app 以 root 跑 postinstall，目标必须是坐在控制台前的那个用户
CONSOLE_USER="$(/usr/bin/stat -f%Su /dev/console)"
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
  CONSOLE_USER="${USER:-root}"
fi
USER_HOME="$(/usr/bin/dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')"
[ -n "$USER_HOME" ] || USER_HOME="/Users/$CONSOLE_USER"
USER_GROUP="$(/usr/bin/id -gn "$CONSOLE_USER" 2>/dev/null || echo staff)"

for BUNDLE in com.microsoft.Word com.microsoft.Excel com.microsoft.Powerpoint; do
  CONTAINER="$USER_HOME/Library/Containers/$BUNDLE"
  WEF="$CONTAINER/Data/Documents/wef"
  CREATED_CONTAINER=0
  [ -d "$CONTAINER" ] || CREATED_CONTAINER=1
  /bin/mkdir -p "$WEF"
  /bin/cp -f "$SCRIPT_DIR/manifest.xml" "$WEF/aiworkdeck-manifest.xml"
  # mkdir -p 以 root 建出来的目录链要交还给用户，否则 Office（沙箱内）读不到
  if [ "$CREATED_CONTAINER" = "1" ]; then
    /usr/sbin/chown -R "$CONSOLE_USER:$USER_GROUP" "$CONTAINER"
  else
    /usr/sbin/chown -R "$CONSOLE_USER:$USER_GROUP" "$WEF"
  fi
done

exit 0
