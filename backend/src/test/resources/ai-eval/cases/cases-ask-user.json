[
  {
    "id": "ask-user-native-stops-and-awaits-input",
    "title": "ask_user（原生）：校验通过即停机，awaiting_input，问题标记随本轮落库，不再调用模型",
    "category": "question",
    "protocol": "native",
    "userInput": "你能帮我清理已经打开的这个文档么",
    "activeDocument": { "id": "1001", "name": "股份认购协议.docx", "fileType": "docx" },
    "turns": [
      {
        "toolCalls": [
          {
            "name": "ask_user",
            "arguments": {
              "question": "「清理」具体指哪一种？",
              "header": "清理范围",
              "options": [
                { "label": "删除混入的审查报告", "description": "只删第 12-21 段那段审查意见，其余不动" },
                { "label": "清理格式", "description": "统一字体段落、删多余空行，不改文字" },
                { "label": "接受全部修订", "description": "接受现有修订并删除批注" }
              ]
            }
          }
        ]
      }
    ],
    "expect": {
      "toolCalls": [ { "name": "ask_user", "argsContain": { "question": "清理" } } ],
      "structureContains": [
        "<question kind=\"ask_user\"",
        "header=\"清理范围\"",
        "<option description=",
        "删除混入的审查报告</option>"
      ],
      "bubbleEndStatus": "awaiting_input",
      "offeredToolsInclude": [ "ask_user" ]
    }
  },
  {
    "id": "ask-user-native-skips-later-calls-in-batch",
    "title": "ask_user 与写入同批：写入不执行（那正是还没被授权的动作），本轮照样停机",
    "category": "question",
    "protocol": "native",
    "userInput": "你能帮我清理已经打开的这个文档么",
    "activeDocument": { "id": "1001", "name": "股份认购协议.docx", "fileType": "docx" },
    "turns": [
      {
        "toolCalls": [
          {
            "name": "ask_user",
            "arguments": {
              "question": "「清理」具体指哪一种？",
              "options": [ "删除混入的审查报告", "清理格式" ],
              "multi_select": true
            }
          },
          { "name": "doc_delete_text", "arguments": { "text": "审查报告" } }
        ]
      }
    ],
    "expect": {
      "toolCalls": [ { "name": "ask_user" } ],
      "structureContains": [ "multi=\"true\"" ],
      "bubbleEndStatus": "awaiting_input"
    }
  },
  {
    "id": "ask-user-xml-fallback-stops",
    "title": "ask_user（XML 兜底，JSON 风格参数）：弱模型主路径同样停机",
    "category": "question",
    "protocol": "xml",
    "userInput": "帮我优化一下这份合同",
    "activeDocument": { "id": "1001", "name": "采购合同.docx", "fileType": "docx" },
    "turns": [
      {
        "text": "<thinking>「优化」没说标准，可能是改措辞、补条款或调格式，先问。</thinking>\n<process name=\"向用户提问\"><tool_code>ask_user({\"question\":\"想从哪方面优化？\",\"options\":[\"对我方更有利\",\"补全缺失条款\",\"只调整格式\"]})</tool_code></process>"
      }
    ],
    "expect": {
      "toolCalls": [ { "name": "ask_user", "argsContain": { "question": "优化" } } ],
      "structureContains": [ "<question kind=\"ask_user\"", "<option>对我方更有利</option>" ],
      "bubbleEndStatus": "awaiting_input"
    }
  },
  {
    "id": "ask-user-invalid-args-corrected-then-stops",
