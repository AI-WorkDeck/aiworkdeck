        "text": "<process name=\"新建文件夹\"><tool_code>create_folder(folderName=\"尽调材料\", projectId=1)</tool_code></process>"
      },
      {
        "text": "<final>已新建「尽调材料」文件夹。</final>"
      }
    ],
    "toolStubs": {
      "create_folder": "Successfully created folder '尽调材料' (folderId=77)."
