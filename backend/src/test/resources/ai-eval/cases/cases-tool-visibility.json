  {
    "id": "writer-active-hides-sheet-and-slide-tools",
    "title": "docx 活跃：不下发 slide_* 与写入类 sheet_*（dev-board#729 ①）",
    "category": "files",
    "protocol": "native",
    "userInput": "把这份合同里的「甲方」都改成「买方」",
    "activeDocument": { "id": "1001", "name": "股权转让协议.docx", "fileType": "docx" },
    "turns": [
      {
        "toolCalls": [
          {
            "name": "doc_find_replace",
            "arguments": { "findText": "甲方", "replaceText": "买方" }
          }
        ]
      },
      { "text": "<final>已把全文 12 处「甲方」改为「买方」，均以修订形式呈现。</final>" }
    ],
    "toolStubs": {
      "doc_find_replace": "{\"success\": true, \"replaced\": 12}"
    },
    "expect": {
      "toolCalls": [{ "name": "doc_find_replace" }],
      "offeredToolsInclude": [
        "doc_find_replace",
        "doc_find_text",
        "doc_get_document_text",
        "doc_audit_structure",
        "doc_restore_checkpoint",
        "sheet_create_file",
        "write_docx"
      ],
      "offeredToolsExclude": [
        "slide_add_page",
        "slide_get_overview",
        "slide_table_set_cell",
        "sheet_write_cells",
        "sheet_get_overview",
        "sheet_read_range"
      ],
      "structureContains": ["<final>"],
      "bubbleEndStatus": "finished"
    }
  },
