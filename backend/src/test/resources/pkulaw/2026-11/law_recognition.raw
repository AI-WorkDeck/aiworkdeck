data: {"jsonrpc": "2.0", "id": "1c9bd0b2-b0d1-4459-bb64-aa1ace956df4", "result": {"content": [{"text": "{\n  \"matched_text\": \"民法典\",\n  \"start_offset\": 3,\n  \"end_offset\": 6,\n  \"law_title\": \"中华人民共和国民法典\",\n  \"version_label\": \"\",\n  \"gid\": \"aa00daaeb5a4fe4ebdfb\",\n  \"timeliness\": \"现行有效\",\n  \"article_number\": \"一千零八十二条\",\n  \"article_content\": \"第一千零八十二条　女方在怀孕期间、分娩后一年内或者终止妊娠后六个月内，男方不得提出离婚；但是，女方提出离婚或者人民法院认为确有必要受理男方离婚请求的除外。\",\n  \"url\": \"https://pkulaw.com/chl/aa00daaeb5a4fe4ebdfb.html?way=mcp\"\n}", "type": "text"}], "isError": false, "structuredContent": {"result": [{"matched_text": "民法典", "start_offset": 3, "end_offset": 6, "law_title": "中华人民共和国民法典", "version_label": "", "gid": "aa00daaeb5a4fe4ebdfb", "timeliness": "现行有效", "article_number": "一千零八十二条", "article_content": "第一千零八十二条　女方在怀孕期间、分娩后一年内或者终止妊娠后六个月内，男方不得提出离婚；但是，女方提出离婚或者人民法院认为确有必要受理男方离婚请求的除外。", "url": "https://pkulaw.com/chl/aa00daaeb5a4fe4ebdfb.html?way=mcp"}]}}}

