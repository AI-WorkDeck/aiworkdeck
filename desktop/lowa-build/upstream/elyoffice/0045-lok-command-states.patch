+/// Whether each listed command may run now.
+static char* getCommandStates(std::string_view aList)
+{
+    SfxViewShell* pViewShell = SfxViewShell::Current();
+    if (!pViewShell)
+    {
+        SetLastExceptionMsg(u"CommandStates: no current view"_ustr);
+        return nullptr;
+    }
+    SfxViewFrame& rFrame = pViewShell->GetViewFrame();
+    SfxDispatcher* pDispatcher = rFrame.GetBindings().GetDispatcher();
+    pDispatcher->Flush();
+    const SfxSlotPool& rPool = SfxSlotPool::GetSlotPool(&rFrame);
+    tools::JsonWriter aJson;
+    {
+        auto aStates = aJson.startNode("commandStates");
+        sal_Int32 nIndex = 0;
+        do
+        {
+            std::string_view aCommand = o3tl::getToken(aList, 0, ',', nIndex);
+            if (!aCommand.starts_with(".uno:"))
+            {
+                SetLastExceptionMsg(u"CommandStates: not a .uno: command"_ustr);
+                return nullptr;
+            }
+            const SfxSlot* pSlot = rPool.GetUnoSlot(OUString::fromUtf8(aCommand.substr(5)));
+            if (!pSlot)
+            {
+                SetLastExceptionMsg(OUString::fromUtf8(aCommand) + u" : unknown command"_ustr);
+                return nullptr;
+            }
+            SfxPoolItemHolder aState;
+            const SfxItemState eState = pDispatcher->QueryState(pSlot->GetSlotId(), aState);
+            aJson.put(aCommand, eState != SfxItemState::DISABLED && eState != SfxItemState::UNKNOWN);
+        } while (nIndex >= 0);
+    }
+    return convertOString(aJson.finishAndGetAsOString());
+}
