       m_pCallback(pCallback),
-      m_pFlushEvent(nullptr),
       m_pData(pData),
       m_nDisableCallbacks(0)
 {
@@ -1638,18 +1637,8 @@ CallbackFlushHandler::CallbackFlushHandler(LibreOfficeKitDocument* pDocument, Li
     }
 }
 
