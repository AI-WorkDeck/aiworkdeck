+void SwWrtShell::InsertFormula(const OUString& rFormula)
+{
+    StartUndo(SwUndoId::INSERT);
+    // A replaced formula's place: anchor, spacing, alignment.
+    std::optional<SfxItemSetFixed<RES_LR_SPACE, RES_UL_SPACE, RES_OPAQUE, RES_ANCHOR>> oPlace;
+    if (IsFrameSelected())
+    {
+        oPlace.emplace(GetAttrPool());
+        GetFlyFrameAttr(*oPlace);
+        // Baseline alignment places a new inline formula itself.
+        if (oPlace->Get(RES_ANCHOR).GetAnchorId() == RndStdIds::FLY_AS_CHAR
+            && oPlace->Get(RES_VERT_ORIENT).GetVertOrient() == css::text::VertOrientation::NONE)
+            oPlace->ClearItem(RES_VERT_ORIENT);
+    }
+    if (IsFrameSelected() || HasSelection())
+        DelRight();
+    // Write where the replaced formula was anchored.
+    if (oPlace && oPlace->Get(RES_ANCHOR).GetContentAnchor())
+    {
+        GetCursor()->DeleteMark();
+        *GetCursor()->GetPoint() = *oPlace->Get(RES_ANCHOR).GetContentAnchor();
+    }
+    const sal_Int32 nStart = GetCursor()->GetPoint()->GetContentIndex();
+    Insert(rFormula);
+    SwPaM* pCursor = GetCursor();
+    pCursor->SetMark();
+    pCursor->GetMark()->SetContent(nStart);
+    SvGlobalName aName(SO3_SM_CLASSID);
+    InsertObject(svt::EmbeddedObjectRef(), &aName);
+    if (oPlace)
+    {
+        const SwFormatAnchor& rOld = oPlace->Get(RES_ANCHOR);
+        if (rOld.GetAnchorId() != RndStdIds::FLY_AS_CHAR)
+        {
+            SwFormatAnchor aAnchor(rOld.GetAnchorId(), rOld.GetPageNum());
+            SfxItemSet aSet(SwFEShell::makeItemSetFromFormatAnchor(GetAttrPool(), aAnchor));
+            SetFlyFrameAttr(aSet);
+        }
+        oPlace->ClearItem(RES_ANCHOR);
+        SetFlyFrameAttr(*oPlace);
+    }
+    EndUndo();
+}
