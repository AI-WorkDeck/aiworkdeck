+/// Implements getCommandValues(".uno:Formula").
+void GetFormula(tools::JsonWriter& rJsonWriter, SwDocShell* pDocShell)
+{
+    SwWrtShell* pWrtShell = pDocShell->GetWrtShell();
+    if (!pWrtShell || !(pWrtShell->GetSelectionType() & SelectionType::Ole)
+        || !pWrtShell->IsOLEMath())
+        return;
+    svt::EmbeddedObjectRef& xObj = pWrtShell->GetOLEObject();
+    if (!svt::EmbeddedObjectRef::TryRunningState(xObj.GetObject()))
+        return;
+    uno::Reference<beans::XPropertySet> xSet(xObj->getComponent(), uno::UNO_QUERY_THROW);
+    rJsonWriter.put("formula", xSet->getPropertyValue(u"Formula"_ustr).get<OUString>());
+}
