+void DomainMapper_Impl::appendEqFormula(const FieldContextPtr& pContext)
+{
+    // the looks index the untrimmed command
+    const OUString aMath = EqToStarMath(pContext->GetCommand(), pContext->GetCommandLooks());
+    if (aMath.isEmpty())
+    {
+        // an unreadable field shows its code, never vanishes
+        appendTextPortion(pContext->GetCommand().trim(), pContext->getProperties());
+        return;
+    }
+    comphelper::EmbeddedObjectContainer aContainer;
+    OUString aName;
+    uno::Reference<embed::XEmbeddedObject> xFormula = aContainer.CreateEmbeddedObject(
+        SvGlobalName(SO3_SM_CLASSID).GetByteSequence(), aName, m_aBaseUrl);
+    uno::Reference<beans::XPropertySet> xMath(xFormula->getComponent(), uno::UNO_QUERY_THROW);
+    xMath->setPropertyValue(u"Formula"_ustr, uno::Any(aMath));
+    double fHeight = 0;
+    if (GetAnyProperty(PROP_CHAR_HEIGHT, pContext->getProperties()) >>= fHeight)
+        xMath->setPropertyValue(u"BaseFontHeight"_ustr, uno::Any(sal_Int16(std::round(fHeight))));
+    appendFormula(xFormula);
+}
+
