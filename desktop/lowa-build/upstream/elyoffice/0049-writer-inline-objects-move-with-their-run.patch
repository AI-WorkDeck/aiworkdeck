+/** the anchor character's fixed raise */
+SwTwips SwAsCharAnchoredObjectPosition::GetRaise() const
+{
+    const SwPosition* pAnchor = GetFrameFormat().GetAnchor().GetContentAnchor();
+    const SwTextNode* pNode = pAnchor ? pAnchor->GetNode().GetTextNode() : nullptr;
+    if (!pNode)
+        return 0;
+    SfxItemSetFixed<RES_CHRATR_ESCAPEMENT, RES_CHRATR_FONTSIZE> aSet(
+        const_cast<SwAttrPool&>(pNode->GetDoc().GetAttrPool()));
+    const sal_Int32 nIndex = pAnchor->GetContentIndex();
+    pNode->GetParaAttr(aSet, nIndex, nIndex + 1);
+    const short nEsc = aSet.Get(RES_CHRATR_ESCAPEMENT).GetEsc();
+    if (nEsc == DFLT_ESC_AUTO_SUPER || nEsc == DFLT_ESC_AUTO_SUB)
+        return 0;
+    return SwTwips(aSet.Get(RES_CHRATR_FONTSIZE).GetHeight()) * nEsc / 100;
+}
