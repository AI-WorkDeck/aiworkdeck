+sal_Int16 DomainMapper_Impl::GetPositionEscapement(sal_Int32 nHalfPoints, double fFontSize)
+{
+    if (!nHalfPoints)
+        return 0;
+    // half-points against the font size in points, as a percentage
+    double fEscapement = fFontSize ? round(nHalfPoints / 2.0 / fFontSize * 100)
+                                   : nHalfPoints > 0 ? DFLT_ESC_SUPER : DFLT_ESC_SUB;
+    return sal_Int16(std::clamp<double>(fEscapement, -MAX_ESC_POS, MAX_ESC_POS));
+}
+
+void DomainMapper_Impl::moveWithRun(const uno::Reference<text::XTextContent>& xContent)
+{
+    auto& rDeferred = m_StreamStateStack.top().deferredCharacterProperties;
+    auto it = rDeferred.find(NS_ooxml::LN_EG_RPrBase_position);
+    if (it == rDeferred.end())
+        return;
+    SwXFrame* pFrame = dynamic_cast<SwXFrame*>(xContent.get());
+    SwFrameFormat* pFormat = pFrame ? pFrame->GetFrameFormat() : nullptr;
+    if (!pFormat || pFormat->GetAnchor().GetAnchorId() != RndStdIds::FLY_AS_CHAR)
+        return;
+    // the anchor character carries the raise
+    SwPaM aChar(*pFormat->GetAnchor().GetContentAnchor());
+    aChar.SetMark();
+    aChar.GetPoint()->AdjustContent(1);
+    // a percentage of the anchor character's own size
+    SfxItemSetFixed<RES_CHRATR_FONTSIZE, RES_CHRATR_FONTSIZE> aSize(aChar.GetDoc().GetAttrPool());
+    aChar.GetPointNode().GetTextNode()->GetParaAttr(aSize, aChar.Start()->GetContentIndex(), aChar.End()->GetContentIndex());
+    const sal_Int16 nEsc = GetPositionEscapement(it->second.get<sal_Int32>(), aSize.Get(RES_CHRATR_FONTSIZE).GetHeight() / 20.0);
+    if (!nEsc)
+        return;
+    // the run's text after it keeps its own position
+    aChar.GetDoc().getIDocumentContentOperations().InsertPoolItem(
+        aChar, SvxEscapementItem(nEsc, 100, RES_CHRATR_ESCAPEMENT), SetAttrMode::DONTEXPAND);
+}
