<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!-- Hardened-runtime entitlements for the app AND the bundled JVM
       (jre/bin/java). The JVM needs JIT + unsigned executable memory
       (HotSpot) and library validation disabled, because bytedeco/javacpp
       extracts unsigned native dylibs (OpenCV/FFmpeg) at runtime. -->
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- 反馈浮窗的语音留言：硬化运行时下没有这条，getUserMedia({audio}) 在签名包里
         会被 TCC 直接拒掉（dev 未签名时却是好的，属于只有装包后才暴露的坑）。
         配套的 NSMicrophoneUsageDescription 在 package.json 的 build.mac.extendInfo。 -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
